# Block direct access to the config files (Apache 2.2 + 2.4 compatible).
# nginx ignores this file: add an equivalent "location" rule there.
<FilesMatch "^config(\.example)?\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>
